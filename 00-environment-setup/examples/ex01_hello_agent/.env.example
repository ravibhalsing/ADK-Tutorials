# Copy this file to `.env` (same folder) and fill it in.
# `.env` is git-ignored; `.env.example` is committed as the template.

# Model id used by agent.py (read via os.environ["MODEL"]).
MODEL=gemini-2.5-flash

# ============================================================
# Vertex AI path — gcloud Application Default Credentials (no API key)
# This is the path this course uses.
# One-time setup on your machine:
#     gcloud auth application-default login
#     gcloud config set project <your-project-id>
# ============================================================
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_API_KEY=

# ============================================================
# Google AI Studio path — a single API key, no Google Cloud project.
# To use this instead, comment out the three Vertex lines above and use:
# ============================================================
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=paste-key-from-https://aistudio.google.com/app/apikey
